{
  "manifest_version": 3,
  "name": "FX Trading Helper",
  "version": "0.1.0",
  "description": "Context-aware AI trading assistant in the Chrome side panel.",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "storage"],
  "action": { "default_title": "FX Trading Helper" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" }
}
