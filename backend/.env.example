# OpenRouter API key (used as LLM_API_KEY for all providers)
LLM_API_KEY=<your openrouter key>
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=FX Trading Helper
# SEARCH_API_KEY is a Tavily API key (news/sentiment search)
SEARCH_API_KEY=<your tavily key>
SEARCH_TIMEOUT_SECONDS=2.0
SEARCH_MAX_RESULTS=6
SEARCH_CACHE_TTL_SECONDS=120
DB_URL=sqlite:///./fx_helper.db
CORS_ALLOW_ORIGINS=*
